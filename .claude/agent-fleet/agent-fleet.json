{
  "warm": "go mod download",
  "warmProbe": "go.sum",
  "platforms": [
    "darwin",
    "linux"
  ],
  "tools": [
    "go"
  ],
  "secrets": {},
  "releasePr": {
    "workflow": "release.yml",
    "base": "main"
  },
  "chores": {
    "security-audit": {
      "when": "mon week 3",
      "areas": [
        "the gRPC plugin server and its request handling (grpc/)",
        "connection config parsing and validation (plugin/connection_config*.go, connection/)",
        "query and connection caches (query_cache/, connection/)",
        "rate limiting and concurrency (rate_limiter/, plugin/hydrate*.go)",
        "logging and telemetry, including what reaches logs (logging/, telemetry/)"
      ],
      "off": true
    },
    "secret-scan": {
      "off": true
    },
    "dependencies": {
      "off": true
    },
    "dependabot-cant-fix": {
      "off": true
    }
  }
}
